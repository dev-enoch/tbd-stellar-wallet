{
  "manifest_version": 3,
  "name": "Stellith — Stellar Wallet",
  "version": "1.0.0",
  "description": "A non-custodial browser-extension wallet for the Stellar network with plain-language previews and smart routing.",
  "icons": {
    "16": "Stellith_logo.jpg",
    "48": "Stellith_logo.jpg",
    "128": "Stellith_logo.jpg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stellith Wallet",
    "default_icon": {
      "16": "Stellith_logo.jpg",
      "48": "Stellith_logo.jpg",
      "128": "Stellith_logo.jpg"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage.js", "Stellith_logo.jpg"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://horizon.stellar.org/*",
    "https://horizon-testnet.stellar.org/*",
    "https://friendbot.stellar.org/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
